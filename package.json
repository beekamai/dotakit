{
  "name": "dotakit",
  "version": "0.3.0",
  "description": "Steam login + Dota 2 Game Coordinator multitool for Bun/Node: guild, profile, live matches, typed GC client, protobuf codegen",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dotakit": "./bin/dotakit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    },
    "./steam": {
      "types": "./dist/steam/index.d.ts",
      "import": "./dist/steam/index.js",
      "require": "./dist/steam/index.cjs"
    },
    "./gc": {
      "types": "./dist/gc/index.d.ts",
      "import": "./dist/gc/index.js",
      "require": "./dist/gc/index.cjs"
    },
    "./guild": {
      "types": "./dist/guild/index.d.ts",
      "import": "./dist/guild/index.js",
      "require": "./dist/guild/index.cjs"
    },
    "./profile": {
      "types": "./dist/profile/index.d.ts",
      "import": "./dist/profile/index.js",
      "require": "./dist/profile/index.cjs"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js",
      "require": "./dist/live/index.cjs"
    },
    "./protobufs": {
      "types": "./dist/protobufs/index.d.ts",
      "import": "./dist/protobufs/index.js",
      "require": "./dist/protobufs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "keywords": [
    "dota2",
    "dota",
    "game-coordinator",
    "steam",
    "steam-user",
    "guild",
    "protobuf",
    "typescript",
    "bun"
  ],
  "license": "MIT",
  "author": "beekamai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beekamai/dotakit.git"
  },
  "homepage": "https://github.com/beekamai/dotakit#readme",
  "bugs": {
    "url": "https://github.com/beekamai/dotakit/issues"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "doctor": "bun run bin/dotakit.ts doctor",
    "gen:messages": "bun run scripts/gen-messages.ts",
    "gen:protos": "bun run scripts/gen-protos.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2"
  },
  "peerDependencies": {
    "steam-user": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "steam-user": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "steam-user": "^5.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  }
}
